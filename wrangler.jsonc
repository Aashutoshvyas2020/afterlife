{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "afterlife",
	"main": "src/index.js",
	"compatibility_date": "2026-09-28",
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "afterlife-production",
			"database_id": "17354293-565a-43e8-b6fc-7ffaf72aa0dc",
			"migrations_dir": "migrations"
		}
	],
	"assets": {
		"directory": "./out",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*", "/health", "/product*"]
	},
	"vars": {
		"STRIPE_PRICE_ID": "price_1UKilfPBBXfqZsxXOxIbQmMu",
		"PUBLIC_URL": "https://afterlife.afterlife-worker.workers.dev"
	}
}