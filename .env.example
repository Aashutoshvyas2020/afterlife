# Configure STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET as remote Wrangler secrets:
# npx wrangler secret put STRIPE_SECRET_KEY
# npx wrangler secret put STRIPE_WEBHOOK_SECRET
# STRIPE_PRICE_ID=price_... # one-time payment price
# CLOUDFLARE_D1_DATABASE_ID=<production D1 database UUID>
# CLOUDFLARE_API_TOKEN=<deployment token, if needed>
# WORKER_URL=https://<deployed-worker>.workers.dev
