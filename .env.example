# Configure STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET as remote Wrangler secrets:
# npx wrangler secret put STRIPE_SECRET_KEY
# npx wrangler secret put STRIPE_WEBHOOK_SECRET
# STRIPE_PRICE_ID=price_... (active one-time test price; non-secret Wrangler var)
# CLOUDFLARE_D1_DATABASE_ID=<production D1 database UUID>
# CLOUDFLARE_API_TOKEN=<deployment token, if using CI>
# PUBLIC_URL=https://<deployed-worker>.workers.dev (non-secret Wrangler var)
# RECOVERED_REPOSITORY=owner/repository (only after verified handoff)
# PRODUCT_NAME=<human-facing name>
# CAPABILITY_AUTH_TOKEN=<same random secret in the Worker and renderer runtime; never commit it>
# npx wrangler secret put CAPABILITY_AUTH_TOKEN
# CAPABILITY_BASE_URL=https://<verified-recovered-service> (required for live capability)
# CAPABILITY_HEALTH_PATH=/health (optional)
# CAPABILITY_RUN_PATH=/run (optional; expects JSON POST input, returns JSON)
# WORKER_URL=https://<deployed-worker>.workers.dev (optional smoke override)
