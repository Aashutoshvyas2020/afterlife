# Copy to .dev.vars for local development; never commit real credentials.
# Production uses Worker secrets, provisioned separately with wrangler secret put.
STRIPE_SECRET_KEY=sk_test_REPLACE
# Live generated products create their own checkout price; no fixed price ID required.
# The preserved legacy checkout also uses STRIPE_WEBHOOK_SECRET and STRIPE_PRICE_ID.

# Live orchestration (server only):
BRAINBASE_TOKEN=REPLACE
# Deployment credentials stay on your machine, never in client code or Worker assets:
# CLOUDFLARE_ACCOUNT_ID=REPLACE
# CLOUDFLARE_API_TOKEN=REPLACE
