# Copy to .dev.vars for local test billing; never commit that file.
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
# Use a fresh Stripe CLI listener secret for local webhooks.
# The non-secret price ID is set in wrangler.jsonc. Override only if needed:
# STRIPE_PRICE_ID=price_REPLACE
# Remote renderer deployments require the same secret on Worker and Python service:
# CAPABILITY_TOKEN=REPLACE
